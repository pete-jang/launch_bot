# Slack Bot Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App Token (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Slack Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# Channel ID where the bot will post daily lunch orders
SLACK_CHANNEL_ID=C1234567890

# Timezone (default: Asia/Seoul)
TZ=Asia/Seoul

# Database Configuration (MariaDB/MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=launch_bot

# Lunchlab Automation (for actual order submission)
LUNCHLAB_USERNAME=your-lunchlab-username
LUNCHLAB_PASSWORD=your-lunchlab-password
LUNCHLAB_BASE_URL=https://b2b.lunchlab.me
SCREENSHOTS_DIR=./screenshots

# Lunchlab Cookies (for production deployment)
# In local development: cookies are loaded from ./data/lunchlab-cookies.json
# In production: set this to the JSON array from the cookie file
# To generate: run `npx ts-node generate-cookie-env.ts`
LUNCHLAB_COOKIES=

# Admin User IDs (comma-separated, for failure notifications)
SLACK_ADMIN_IDS=U1234567890,U0987654321
